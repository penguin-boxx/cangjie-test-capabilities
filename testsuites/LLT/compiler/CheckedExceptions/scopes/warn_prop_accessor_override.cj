// Checked exceptions (diagnostics on property accessors): an accessor declared without a body --
// as in an interface, or as a field-like property -- is generated by the compiler and has no
// position of its own, and its identifier is synthesized ('$valueget'). A diagnostic about it is
// reported against the property the author wrote. Attaching one to the accessor instead crashed
// the compiler ("begin of range is zero") on any package where an implementation's accessor
// inferred a capability the interface's accessor did not have -- stdx.net.http, for one.

// EXEC: %compiler %cmp_opt --experimental --enable-chexc=warn %n.cj -o %output 2> warn_out.txt
// EXEC: %run %output
// EXEC-PIPE: cat warn_out.txt | compare %f
// ASSERT: scan warning: exception type 'Class-AException' in 'throws' clause of 'value' is not covered
// ASSERT: scan prop value: Int64

class AException <: Exception {}

interface HasValue {
    prop value: Int64
}

class Impl <: HasValue {
    public prop value: Int64 {
        get() {
            throw AException()
        }
    }
}

main(): Int64 {
    let i: HasValue = Impl()
    try {
        return i.value
    } catch (e: AException) {
        return 0
    }
}
