// Rewrite acceptance: §4.4, §5.4.
// Effect capabilities obey the same protected-body escape rule as exception capabilities.
//
// EXEC-PIPE-1: %compiler %cmp_opt %enableEH --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
// ASSERT: regex error:.*capability.*(escap|outside|outlive)
// ASSERT: regex-not error:.*(unexpected token|unclosed delimiter|expected .*found|unrecognized|undeclared identifier)
// ASSERT: scan-not Internal Compiler Error
// ASSERT: regex captured_handler_escape_neg\.cj:17:[0-9]+:

import stdx.effect.*
class Get <: Command<Int64> {}
class AE <: Exception {}

func value(): Int64 performs Get { perform Get() }
main(): Int64 {
    var saved: (() -> Int64) @local? = { => 0 }
    try { saved = { => value() } } handle (_: Get) { resume with 42 } // ERROR
    return 0
}
