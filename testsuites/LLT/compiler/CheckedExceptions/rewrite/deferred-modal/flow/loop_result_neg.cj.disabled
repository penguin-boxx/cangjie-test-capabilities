// ASSERT: regex-not error:.*(unexpected token|unclosed delimiter|undeclared identifier)
// ASSERT: scan-not Internal Compiler Error

class AE <: Exception {}
func risky(): Unit throws AE { throw AE() }

func create(run: Bool): (() -> Unit) @local? throws () {
    try {
        var f: (() -> Unit) @local? = { => }
        while (run) {
            f = { => risky() }
            break
        }
        f // ERROR: loop-carried capture leaves the supplying body
    } catch (_: AE) { { => } }
}
main(): Int64 { 0 }
