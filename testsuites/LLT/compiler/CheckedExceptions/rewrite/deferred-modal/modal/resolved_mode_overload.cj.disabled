// Rewrite acceptance: §3.5, §3.7, §5.3.3.
// An already synthesized capture mode determines an unambiguous ordinary mode overload.
//
// EXEC: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output
// EXEC: %run %output

class AE <: Exception {}
func risky(): Unit { throw AE() }
func select(f: () -> Unit): Int64 throws () { 1 }
func select(f: (() -> Unit) @local?): Int64 throws () { 2 }
main(): Int64 {
    let plain = { => }
    if (select(plain) != 1) { return 1 }
    try {
        let capturing = { => risky() }
        if (select(capturing) != 2) { return 1 }
    } catch (e: AE) { return 1 }
    return 0
}
