// Rewrite acceptance: §3.9.3.
// A capturing class does not supply capabilities to static methods.
//
// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
// ASSERT: regex error:.*Cannot find a capability for 'Class-AE'
// ASSERT: regex-not error:.*(unexpected token|unclosed delimiter|expected .*found|unrecognized|undeclared identifier)
// ASSERT: scan-not Internal Compiler Error
// ASSERT: regex capturing_static_neg\.cj:19:[0-9]+:

class AE <: Exception {}
interface Runner { func run(this @local?): Unit }
class Adapter <: Runner captures AE {
    init(this @local!) { exclave {} }
    public func run(this @local?): Unit { throw AE() }
}

class StaticAdapter captures AE {
    init(this @local!) { exclave {} }
    static func fail(): Unit throws () { throw AE() } // ERROR
}
main(): Int64 { 0 }
