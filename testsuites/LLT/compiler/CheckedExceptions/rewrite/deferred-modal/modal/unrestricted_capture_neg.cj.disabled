// Rewrite acceptance: §3.5, §4.4.5, §5.3.3.
// Capability capture must affect ordinary mode compatibility before the value is consumed.
//
// EXEC-PIPE-1: %compiler %cmp_opt --experimental --enable-checked-exceptions %n.cj -o %output 2>&1 | compare %f
// ASSERT: regex error:.*(local\?|capability|mismatched types)
// ASSERT: regex-not error:.*(unexpected token|unclosed delimiter|expected .*found|unrecognized|undeclared identifier)
// ASSERT: scan-not Internal Compiler Error
// ASSERT: regex unrestricted_capture_neg\.cj:15:[0-9]+:

class AE <: Exception {}
class BE <: Exception {}
func risky(): Unit { throw AE() }
func reject(): Unit {
    let f = { => risky() }
    let unrestricted: () -> Unit = f // ERROR: synthesized mode is local?
}
main(): Int64 { 0 }
